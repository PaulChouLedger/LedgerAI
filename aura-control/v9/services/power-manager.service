[Unit]
Description=Aura Adaptive Power Manager
After=network.target
Before=aura4.service

[Service]
Type=simple
User=root
ExecStart=/home/ledger/aura-env/bin/python3 /home/ledger/Aura4/aura-control/v9/boot/power_manager.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
