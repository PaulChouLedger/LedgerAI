# Aura v9 Voice Assistant systemd Service
#
# Runs the modular v9 entry point (aura-control/v9/aura.py).
# LLM runs natively (not Docker) for direct GPU access.
# Docker is used for Whisper and Memory containers only.
#
# Install (symlink — auto-updates on git pull):
#   sudo ln -sf /home/ledger/Aura4/aura-control/v9/services/aura-v2.service /etc/systemd/system/aura.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable aura.service
#
# Control:
#   sudo systemctl start aura.service
#   sudo systemctl stop aura.service
#   sudo systemctl restart aura.service
#   journalctl -u aura.service -f

[Unit]
Description=Aura Voice Assistant
After=network.target docker.service display-manager.service xvf3800-tuning.service set-default-audio.service
Wants=docker.service display-manager.service xvf3800-tuning.service set-default-audio.service
Requires=docker.service

[Service]
Type=simple
User=ledger
Group=ledger
WorkingDirectory=/home/ledger/Aura4/aura-control/v9

# Display / audio environment
Environment="DISPLAY=:0"
Environment="HOME=/home/ledger"
Environment="PATH=/home/ledger/aura-env/bin:/usr/local/bin:/usr/bin:/bin"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="XAUTHORITY=/run/user/1000/.Xauthority"

# Performance: prevent OMP threads from spin-waiting
Environment="OMP_WAIT_POLICY=PASSIVE"
Environment="OMP_NUM_THREADS=2"
Environment="MKL_NUM_THREADS=2"
Environment="HF_HUB_OFFLINE=1"
Environment="TRANSFORMERS_OFFLINE=1"

# Farsight RTX (72B Qwen via Tailscale)
Environment="AURA_FARSIGHT_URL=http://100.76.191.92:11435"

# Auto-detect DISPLAY from X sockets at runtime
ExecStartPre=/bin/bash -c 'SOCKET=$(ls /tmp/.X11-unix/ 2>/dev/null | grep "^X" | head -1); if [ -n "$SOCKET" ]; then NUM=$(echo "$SOCKET" | sed "s/X//"); export DISPLAY=:$NUM; else export DISPLAY=:0; fi; while [ ! -e "/tmp/.X11-unix/${SOCKET:-X0}" ]; do sleep 1; done'
ExecStartPre=/bin/bash -c 'SOCKET=$(ls /tmp/.X11-unix/ 2>/dev/null | grep "^X" | head -1); if [ -n "$SOCKET" ]; then NUM=$(echo "$SOCKET" | sed "s/X//"); export DISPLAY=:$NUM; else export DISPLAY=:0; fi; xhost +local: 2>/dev/null || true'
ExecStartPre=/bin/bash -c 'gsettings set org.gnome.desktop.screensaver lock-enabled false 2>/dev/null || true'
ExecStartPre=/bin/bash -c 'gsettings set org.gnome.desktop.lockdown disable-lock-screen true 2>/dev/null || true'
ExecStartPre=/bin/bash -c 'gsettings set org.gnome.desktop.screensaver idle-activation-enabled false 2>/dev/null || true'
ExecStartPre=/bin/bash -c 'gsettings set org.gnome.desktop.session idle-delay 0 2>/dev/null || true'
# Wait for display manager
ExecStartPre=/bin/sleep 5

ExecStart=/home/ledger/aura-env/bin/python3 -u /home/ledger/Aura4/aura-control/v9/aura.py

# Kill main process only — let ExecStopPost clean up children
KillSignal=SIGKILL
KillMode=process
TimeoutStopSec=5
# Kill native LLM and any orphaned aura processes after main is dead.
# Runs as root (+) so it won't be killed by the service teardown.
ExecStopPost=+/bin/bash -c 'pkill -9 -f "aura-env/bin/python3 -u container_rest.py" 2>/dev/null || true; pkill -9 -f "aura-env/bin/python3.*aura.py" 2>/dev/null || true'

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
