# Ubuntu Keyboard Disabler Service
# Monitors Aura service and disables Ubuntu on-screen keyboard while it's running
#
# This service runs alongside aura.service and continuously disables
# Ubuntu's on-screen keyboard (onboard, caribou, matchbox-keyboard)
# while main.py is running.
#
# To disable this service:
#   sudo systemctl disable disable-keyboard-monitor.service
#
# To check status:
#   sudo systemctl status disable-keyboard-monitor.service
#
# To view logs:
#   journalctl -u disable-keyboard-monitor.service -f

[Unit]
Description=Disable Ubuntu Keyboard While Aura is Running
After=aura.service
Wants=aura.service
PartOf=aura.service

[Service]
Type=simple
User=__AURA_USER__
Group=__AURA_USER__
Restart=on-failure
RestartSec=5
# Monitor both aura.service and manual main.py execution
# Check if aura.service is active OR if main.py process is running
ExecStart=/bin/bash -c 'while systemctl is-active --quiet aura.service || pgrep -f "python.*main.py" > /dev/null; do pkill -f "onboard|caribou|matchbox-keyboard" 2>/dev/null || true; sleep 2; done'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=aura.service

