# Set Default Audio Output Service
# Automatically sets ALSA and PulseAudio default output to UACDemoV1.0 on boot
#
# This service file is FULLY DYNAMIC - no modifications needed!
# - Paths resolved using common locations (ledger, aura users)
# - Can be updated via git pull without any changes!
#
# To install (first time only):
#   Run: setup/scripts/install_aura_bootable.sh
#   Or manually:
#   1. sudo cp setup/scripts/set-default-audio.service /etc/systemd/system/
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable set-default-audio.service
#
# To update after git pull (OTA updates):
#   Just do: git pull
#   Then: sudo systemctl daemon-reload
#   Changes take effect on next reboot
#
# To disable:
#   sudo systemctl disable set-default-audio.service

[Unit]
Description=Set Default Audio Output (UACDemoV1.0)
# Wait for USB subsystem and ALSA to be ready
After=sys-subsystem-usb-devices.target sound.target
Wants=sys-subsystem-usb-devices.target sound.target
# Note: PulseAudio may run as user service - script handles this

[Service]
Type=oneshot
RemainAfterExit=yes
# Run as ledger user (change to your username if different)
# PulseAudio requires running as the user who owns the session
User=ledger
Group=ledger
# Wait for audio devices to be available, then run the script
# The script handles: ALSA .asoundrc and PulseAudio default sink
ExecStart=/bin/bash -c 'for i in {1..30}; do if aplay -l 2>/dev/null | grep -qE "UACDemoV1\.0|UACDemoV10"; then break; fi; sleep 1; done; sleep 2; for dir in "/home/ledger/LedgerAI" "/home/aura/LedgerAI"; do if [ -f "$$dir/setup/scripts/set_default_audio_on_boot.sh" ]; then cd "$$dir" && bash setup/scripts/set_default_audio_on_boot.sh; exit $$?; fi; done; echo "Error: Could not find LedgerAI directory or set_default_audio_on_boot.sh"; exit 1'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
