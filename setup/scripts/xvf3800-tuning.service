# XVF3800 Auto-Tuning Service
# Automatically configures XVF3800 hardware DSP on boot
#
# Available Presets (change in ExecStart line):
#   - agc_20_ec       : agc_20 + Echo Cancellation ON (PP_ECHOONOFF=1) - DEFAULT ⭐ RECOMMENDED
#   - agc_20          : HPF 70Hz + AGC with 20% increase (0.096)
#   - agc_10          : HPF 70Hz + AGC with 10% increase (0.088)
#   - balanced_beam    : HPF 70Hz + AGC (0.08, 30dB)
#   - agc_only        : AGC only (0.08, 30dB) - no HPF
#   - hpf_only        : HPF 70Hz only (minimal processing)
#   - ultra_sensitive : AGC (0.10, 45dB) - Far-field optimized
#   - far_field       : Optimized for 8-16 feet
#   - near_field      : Optimized for 1-6 feet
#   - reset           : Factory defaults
#   - show            : Show current settings
#
# This service file is FULLY DYNAMIC - no modifications needed!
# - Paths resolved using systemd %h (home directory) and common locations
# - User detected automatically by Python script (via SUDO_USER or ~)
# - Can be updated via git pull without any changes!
#
# To install (first time only):
#   Run: setup/scripts/install_aura_bootable.sh
#   Or manually:
#   1. sudo ln -s $(pwd)/setup/scripts/xvf3800-tuning.service /etc/systemd/system/
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable xvf3800-tuning.service
#
# To update after git pull (OTA updates):
#   Just do: git pull
#   That's it! Service file updates automatically (it's a symlink).
#   
#   Changes take effect:
#   - Automatically on next reboot (systemd loads latest service file)
#   - Or immediately: sudo systemctl daemon-reload
#   - Or automatically if git hook is installed (runs daemon-reload after pull)
#
# To change preset:
#   1. sudo nano /etc/systemd/system/xvf3800-tuning.service
#   2. Change "agc_20_ec" to desired preset in ExecStart line
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl restart xvf3800-tuning.service
#
# To disable auto-tune:
#   sudo systemctl disable xvf3800-tuning.service

[Unit]
# Wait for USB subsystem and ALSA to be ready
After=sys-subsystem-usb-devices.target sound.target
Wants=sys-subsystem-usb-devices.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Wait for device to be ready, then find LedgerAI directory and run tuning script
# Python script handles user detection
# Retry logic: wait up to 30 seconds for device to be available
ExecStart=/bin/bash -c 'for i in {1..30}; do if lsusb | grep -q "2886:0018"; then break; fi; sleep 1; done; sleep 2; for dir in "%h/LedgerAI" "/home/ledger/LedgerAI" "/home/aura/LedgerAI"; do if [ -f "$$dir/setup/scripts/tune_xvf3800.py" ]; then cd "$$dir" && python3 -B setup/scripts/tune_xvf3800.py agc_20_ec; exit $$?; fi; done; echo "Error: Could not find LedgerAI directory"; exit 1'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
