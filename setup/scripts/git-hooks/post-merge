#!/bin/bash
# Git post-merge hook - runs automatically after 'git pull'
# Attempts to reload systemd if service file changed
# This hook is installed automatically by install_aura_bootable.sh

# Check if xvf3800 service file was updated
if git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null | grep -q "setup/scripts/xvf3800-tuning.service"; then
    echo ""
    echo "🔄 XVF3800 service file updated - reloading systemd..."
    
    # Try to reload systemd (may require sudo, but attempt anyway)
    if sudo -n systemctl daemon-reload 2>/dev/null; then
        echo "✅ Systemd reloaded successfully - service changes are active"
    else
        echo "⚠️  Could not reload systemd automatically (needs sudo password)"
        echo "💡 Run manually: sudo systemctl daemon-reload"
        echo "💡 Or reboot - changes will take effect automatically on next boot"
    fi
fi

