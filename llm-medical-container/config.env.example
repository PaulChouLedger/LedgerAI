# =====================================
# Aura LLM Medical Container Configuration
# =====================================

# === RAG Configuration ===
# Enable/disable external RAG container (GPU FAISS)
# - true: Use RAG container on port 11435 with GPU-accelerated FAISS
# - false: Use local CPU-based FAISS within LLM container
RAG_ENABLED=true

# RAG Service URL (only used when RAG_ENABLED=true)
RAG_SERVICE_URL=http://localhost:11435

# RAG request timeout in seconds
RAG_TIMEOUT=10

# === Model Configuration ===
# Path to the LLM model file
MODEL_PATH=/data/gemma-2-9b-it-Q6_K_L.gguf
MODEL_SIMPLE_PATH=/data/gemma-2-2b-it-Q8_0.gguf

# === Service Configuration ===
# Port for LLM service
LLM_PORT=11434

# === Logging ===
LOG_LEVEL=INFO

