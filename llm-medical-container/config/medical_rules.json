{
  "_metadata": {
    "version": "2.0",
    "description": "Universal anatomical rules for all organ systems. Supports quadrant-specific, directional, and regional classifications with opposite detection to prevent false positives.",
    "last_updated": "2025-11-02"
  },
  "anatomical_components": {
    "directional_keywords": {
      "horizontal": {
        "left": ["left", "left side", "left-sided", "leftward"],
        "right": ["right", "right side", "right-sided", "rightward"]
      },
      "vertical": {
        "upper": ["upper", "top", "superior", "above", "high"],
        "lower": ["lower", "bottom", "inferior", "below", "low"]
      },
      "anterior_posterior": {
        "anterior": ["front", "anterior", "ventral"],
        "posterior": ["back", "posterior", "dorsal"]
      }
    },
    "quadrant_patterns": {
      "right_upper": ["right upper quadrant", "ruq", "right upper", "upper right quadrant", "upper right", "right upper quad"],
      "right_lower": ["right lower quadrant", "rlq", "right lower", "lower right quadrant", "lower right", "right lower quad"],
      "left_upper": ["left upper quadrant", "luq", "left upper", "upper left quadrant", "upper left", "left upper quad"],
      "left_lower": ["left lower quadrant", "llq", "left lower", "lower left quadrant", "lower left", "left lower quad"]
    },
    "region_keywords": {
      "chest": ["chest", "thorax", "thoracic", "sternum", "breastbone", "breast"],
      "abdomen": ["abdomen", "abdominal", "belly", "stomach area"],
      "pelvis": ["pelvic", "pelvis", "pelvic region"],
      "head": ["head", "cranial", "skull"],
      "back": ["back", "dorsal", "posterior"],
      "limb": ["arm", "leg", "limb", "extremity"]
    }
  },
  "anatomical_opposites": {
    "horizontal": {
      "left": ["right"],
      "right": ["left"]
    },
    "vertical": {
      "upper": ["lower"],
      "lower": ["upper"],
      "top": ["bottom"],
      "bottom": ["top"],
      "superior": ["inferior"],
      "inferior": ["superior"],
      "high": ["low"],
      "low": ["high"]
    },
    "quadrants": {
      "right_upper": ["right_lower", "left_upper", "left_lower"],
      "right_lower": ["right_upper", "left_lower", "left_upper"],
      "left_upper": ["left_lower", "right_upper", "right_lower"],
      "left_lower": ["left_upper", "right_lower", "right_upper"]
    },
    "anterior_posterior": {
      "anterior": ["posterior"],
      "posterior": ["anterior"],
      "front": ["back"],
      "back": ["front"],
      "ventral": ["dorsal"],
      "dorsal": ["ventral"]
    }
  },
  "word_overlap_rules": {
    "penalty_triggers": {
      "opposite_direction_detected": {
        "description": "If patient answer and guideline term share horizontal direction (left/right) but have opposite vertical direction (upper/lower), cancel all word match boost",
        "example": "patient: 'right upper quadrant' vs guideline: 'right lower quadrant' → cancel boost despite 'right' + 'quadrant' match"
      },
      "opposite_quadrant_detected": {
        "description": "If patient answer and guideline term are in opposite quadrants, cancel all word match boost",
        "example": "patient: 'right upper quadrant' vs guideline: 'left lower quadrant' → cancel boost"
      },
      "opposite_horizontal_detected": {
        "description": "If patient answer and guideline term have opposite horizontal directions (left vs right), apply penalty",
        "example": "patient: 'left side' vs guideline: 'right side' → return -0.3"
      }
    },
    "allowed_overlap": {
      "same_quadrant": "Full boost allowed",
      "same_direction_both_levels": "Full boost allowed (e.g., both 'right upper quadrant')",
      "vague_match": "Partial boost (e.g., 'right side' matches 'right upper quadrant')",
      "bilateral_match": "Bilateral conditions (can occur on either side OR both sides) match either left or right patient answers, as well as bilateral answers. 'Bilateral' tag means condition can affect left side, right side, or both."
    }
  },
