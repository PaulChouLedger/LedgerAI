# ReSpeaker Auto-Tuning Service
# Automatically configures ReSpeaker hardware DSP on boot
#
# Available Presets (change in ExecStart line):
#   - clean      : HPF + Moderate AGC + Max Stationary NS - DEFAULT
#   - near_field : HPF + moderate AGC (0.08 RMS) - for 1-6 feet
#   - far_field  : High AGC + noise suppression (0.03 RMS) - for 8-16 feet
#   - reset      : Factory defaults - all processing OFF
#
# To change preset:
#   1. sudo nano /etc/systemd/system/respeaker-tuning.service
#   2. Change "clean" to desired preset in ExecStart line below
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl restart respeaker-tuning.service
#
# To disable auto-tune:
#   sudo systemctl disable respeaker-tuning.service

[Unit]
Description=ReSpeaker Hardware DSP Configuration
After=multi-user.target
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/usr/bin/python3 /home/aura/LedgerAI/scripts/tune_respeaker.py clean
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

