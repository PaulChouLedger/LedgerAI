# Aura Voice Assistant systemd Service
#
# Launches via boot/start_aura.sh which handles:
#   1. Display/cursor setup
#   2. Native LLM startup (Qwen2.5-3B on GPU)
#   3. Docker containers (Whisper, Memory)
#   4. aura.py (GUI + voice pipeline)
#
# Install (symlink — auto-updates on git pull):
#   sudo ln -sf /home/ledger/Aura4/aura/services/aura-v2.service /etc/systemd/system/aura4.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable aura4.service
#
# Control:
#   sudo systemctl start aura4
#   sudo systemctl stop aura4
#   sudo systemctl restart aura4
#   journalctl -u aura4 -f

[Unit]
Description=Aura Voice Assistant
After=network.target docker.service display-manager.service xvf3800-tuning.service set-default-audio.service
Wants=docker.service display-manager.service xvf3800-tuning.service set-default-audio.service
Requires=docker.service

[Service]
Type=simple
User=ledger
Group=ledger
WorkingDirectory=/home/ledger/Aura4

# Display / audio environment
Environment="DISPLAY=:0"
Environment="HOME=/home/ledger"
Environment="PATH=/home/ledger/aura-env/bin:/usr/local/bin:/usr/bin:/bin"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="XAUTHORITY=/run/user/1000/.Xauthority"
Environment="DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus"

# Watch face color scheme (ferrari = red, rafael = blue)
Environment="AURA_COLOR_SCHEME=ferrari"

ExecStart=/home/ledger/Aura4/boot/start_aura.sh

# Kill entire process group — catches backgrounded LLM + unclutter.
# SIGTERM first (10s grace), then SIGKILL.  No orphans.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10
# Belt-and-suspenders: release ALSA devices after teardown
ExecStopPost=+/bin/bash -c 'for d in /dev/snd/pcmC*c /dev/snd/pcmC*p; do [ -e "$d" ] && fuser -k "$d" 2>/dev/null; done; true'

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
