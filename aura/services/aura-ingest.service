# Aura RAG Auto-Ingest systemd Service
#
# Standalone watcher for data/input/ — keeps FAISS index in sync regardless
# of whether the main LLM service is up. AuraConnect BLE drops files into
# data/input/, this watcher embeds them; LLM reads the index on startup.
#
# Install (symlink — auto-updates on git pull):
#   sudo ln -sf /home/ledger/Aura4/aura/services/aura-ingest.service /etc/systemd/system/aura-ingest.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aura-ingest.service
#
# Logs:
#   journalctl -u aura-ingest -f

[Unit]
Description=Aura RAG Auto-Ingest Watcher
After=network.target

[Service]
Type=simple
User=ledger
Group=ledger
WorkingDirectory=/home/ledger/Aura4
Environment="HOME=/home/ledger"
Environment="PATH=/home/ledger/aura-env/bin:/usr/local/bin:/usr/bin:/bin"

ExecStart=/home/ledger/aura-env/bin/python3 -u /home/ledger/Aura4/aura/services/ingest_watcher.py

# Resource caps so embedding bursts can't starve aura.py (voice listener,
# Whisper, LLM) or wedge WiFi. On Jetson Orin NX (8 cores), cap to 2 cores
# and run at low priority. A backfill of 100+ chunks now takes longer in
# wall-clock time but stays out of the way of real-time voice.
CPUQuota=200%
Nice=15
IOSchedulingClass=idle
# Cap embedder thread pools too, so torch / sentence-transformers don't
# spawn 8 worker threads against our 2-core quota and thrash.
Environment="OMP_NUM_THREADS=2"
Environment="MKL_NUM_THREADS=2"
Environment="OPENBLAS_NUM_THREADS=2"
Environment="TOKENIZERS_PARALLELISM=false"

Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
