# Byte-compiled / optimized / DLL files
__pycache__/

# Distribution / packaging
*.egg-info/
*.egg

# dotenv
!.env.example
**/*.env

# IDE
.vscode/*
*.code-workspace
.idea/
**/*.ipynb_checkpoints

# misc
**/.DS_Store
log*.txt
scratch/
scratch*.py
**/*.nfs*

.venv/*

# heavy model files — never commit GGUFs or large binaries
*.gguf
*/cache/*
llm-container/models/qwen2.5-1.5b-instruct-q4_0.gguf
aura-control/voices/aura_full.pt

# Piper training artifacts (large binary)
training/piper-voice/dataset/wavs/
training/piper-voice/piper_dataset/
training/piper-voice/output/

# Generated artifacts
data/briefings/
data/qa_logs/

.claude/scheduled_tasks.lock
data/voice_profiles/
data/app_settings.json

# RAG corpus + index. These are runtime/user data, not source.
# Listing them here makes start_aura.sh's `git stash --include-untracked`
# skip them on every boot, so AuraConnect uploads + the FAISS index
# survive reboots.
data/input/
data/embeddings/
data/cpu_ingest_state.json

# TG growth/experimentation engine (2026-08-22). Event streams and
# experiment state carry per-user ids and interaction records: local only,
# never in git. Aggregates travel via growth_report.py output, nothing else.
data/telegram/growth_events.jsonl
data/telegram/growth_state.json
data/telegram/strategy_assignments.json
data/telegram/bandit_state.json
data/telegram/growth_reports/
# Pre-existing capture files that were untracked but never ignored — these
# hold verbatim user messages and must not be sweepable into a commit.
data/telegram/engagement_metrics.jsonl
data/telegram/metrics_index.json
data/telegram/dm_history.jsonl
