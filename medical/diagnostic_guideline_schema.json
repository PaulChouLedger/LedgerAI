{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagnostic Guideline Schema",
  "description": "Structured diagnostic guideline for RAG-powered dynamic medical assessment",
  "type": "object",
  "required": [
    "condition",
    "category",
    "chief_complaint_triggers",
    "key_features",
    "diagnostic_questions",
    "red_flags"
  ],
  "properties": {
    "condition": {
      "type": "string",
      "description": "Primary diagnosis name (e.g., 'Acute Appendicitis')",
      "example": "Acute Appendicitis"
    },
    "category": {
      "type": "string",
      "enum": [
        "gastrointestinal",
        "cardiovascular",
        "respiratory",
        "neurological",
        "musculoskeletal",
        "renal",
        "endocrine",
        "infectious",
        "dermatological"
      ],
      "description": "Medical specialty/organ system"
    },
    "icd10_codes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "ICD-10 diagnostic codes",
      "example": ["K35.80", "K35.89"]
    },
    "chief_complaint_triggers": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Phrases that should trigger consideration of this diagnosis",
      "example": ["abdominal pain", "belly pain", "stomach pain", "RLQ pain"]
    },
    "prevalence": {
      "type": "string",
      "enum": ["common", "uncommon", "rare"],
      "description": "How commonly this diagnosis occurs"
    },
    "urgency": {
      "type": "string",
      "enum": ["emergent", "urgent", "non-urgent"],
      "description": "Typical acuity level"
    },
    "key_features": {
      "type": "object",
      "required": ["classic_presentation", "typical_demographics"],
      "properties": {
        "classic_presentation": {
          "type": "string",
          "description": "Typical clinical presentation summary",
          "example": "RLQ pain with anorexia, nausea, and fever. Pain often begins periumbilically then migrates to RLQ."
        },
        "typical_demographics": {
          "type": "string",
          "description": "Age, sex, risk factors",
          "example": "Most common in ages 10-30. Slight male predominance."
        },
        "pathophysiology_brief": {
          "type": "string",
          "description": "Brief explanation of disease mechanism"
        }
      }
    },
    "diagnostic_questions": {
      "type": "array",
      "description": "Ordered list of questions to ask for diagnosis",
      "items": {
        "type": "object",
        "required": ["question_focus", "diagnostic_value", "expected_positive_responses"],
        "properties": {
          "question_focus": {
            "type": "string",
            "description": "What aspect to ask about",
            "example": "pain location and migration"
          },
          "diagnostic_value": {
            "type": "string",
            "enum": ["critical", "high", "moderate", "low"],
            "description": "How important this question is for diagnosis"
          },
          "expected_positive_responses": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Responses that suggest this diagnosis",
            "example": ["started around belly button", "moved to right lower side", "RLQ"]
          },
          "negative_responses": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Responses that argue against this diagnosis"
          },
          "context": {
            "type": "string",
            "description": "Additional context for the LLM on how to use this question"
          }
        }
      }
    },
    "physical_exam_findings": {
      "type": "array",
      "description": "Key exam findings if available",
      "items": {
        "type": "object",
        "properties": {
          "finding": {"type": "string"},
          "sensitivity": {"type": "string"},
          "specificity": {"type": "string"}
        }
      }
    },
    "red_flags": {
      "type": "array",
      "description": "Emergency warning signs requiring immediate action",
      "items": {
        "type": "object",
        "required": ["symptom", "urgency", "action"],
        "properties": {
          "symptom": {
            "type": "string",
            "example": "Severe abdominal pain with rigidity"
          },
          "urgency": {
            "type": "string",
            "enum": ["call_911", "emergency_department", "urgent_care_today"]
          },
          "action": {
            "type": "string",
            "example": "Immediate surgical evaluation needed - possible perforation"
          }
        }
      }
    },
    "differential_diagnoses": {
      "type": "array",
      "description": "Other conditions to consider and how to distinguish them",
      "items": {
        "type": "object",
        "required": ["condition", "distinguishing_features"],
        "properties": {
          "condition": {
            "type": "string",
            "example": "Gastroenteritis"
          },
          "distinguishing_features": {
            "type": "array",
            "items": {"type": "string"},
            "example": [
              "Diarrhea more prominent than pain",
              "Pain is crampy and diffuse, not localized to RLQ",
              "Often preceded by sick contacts"
            ]
          }
        }
      }
    },
    "diagnostic_tests": {
      "type": "array",
      "description": "Tests that confirm or rule out diagnosis",
      "items": {
        "type": "object",
        "properties": {
          "test": {"type": "string"},
          "indication": {"type": "string"},
          "typical_findings": {"type": "string"}
        }
      }
    },
    "treatment_summary": {
      "type": "string",
      "description": "Brief treatment overview (for completeness)"
    },
    "evidence_source": {
      "type": "object",
      "description": "Clinical evidence references",
      "properties": {
        "primary_reference": {"type": "string"},
        "guideline_source": {"type": "string"},
        "last_reviewed": {"type": "string", "format": "date"}
      }
    }
  }
}

