# Farsight Hub — Fleet management dashboard
# Public URL: https://paul-b650-eagle-ax.taild3b54e.ts.net/
#
# Install:
#   sudo ln -sf /home/paul/LedgerAI/services/farsight-hub.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable farsight-hub.service

[Unit]
Description=Farsight Hub Dashboard
After=network.target tailscaled.service

[Service]
Type=simple
User=paul
WorkingDirectory=/home/paul/LedgerAI
ExecStart=/usr/bin/python3 -u farsight_hub.py
Restart=always
RestartSec=5
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
