# ============================================
# AURA CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# This file is safe to commit to GitHub (no secrets)
#
# Usage:
#   cp .env.example .env
#   nano .env
#   # Or use: ./aura_config.sh

# ============================================
# EHR INTEGRATION
# ============================================
EHR_INTEGRATION_ENABLED=false

# ============================================
# LLM MODEL CONFIGURATION
# ============================================
SIMPLE_CHAT_FORMAT=llama-3
SIMPLE_N_CTX=2048
SIMPLE_MODEL_PATH=/models/Llama-3.2-1B-Instruct.Q4_K_M.gguf
LLM_STOP=n/n

# ============================================
# API KEYS (REQUIRED)
# ============================================
# ElevenLabs API Key (REQUIRED for TTS)
# Get your key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_VOICE_ID=default

# Telegram Bot (optional)
# Create bot: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# GitHub OTA Updates (optional)
# Create token: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# ============================================
# LLM PARAMETERS
# ============================================

# Primary settings (used for question generation and general tasks)
LLM_TEMPERATURE_SIMPLE=0.4      # Increased from 0.2 for more natural questions
LLM_TOP_P=0.8                   # Increased from 0.7 for better variety
LLM_TOP_K=50                    # Increased from 40 for more diversity
LLM_REPEAT_PENALTY=1.2          # Increased from 1.15 to avoid repetitive questions
LLM_PRESENCE_PENALTY=0.1        # Increased from 0.0 to encourage diversity
LLM_FREQUENCY_PENALTY=0.3       # Increased from 0.2 to avoid word repetition
LLM_NUM_PREDICT=120             # Increased from 40 for complete questions

# Optional task-specific overrides
LLM_TEMPERATURE_EMPATHETIC=0.4  # For empathetic statements
LLM_TEMPERATURE_SUMMARY=0.25    # For summaries (lower for accuracy)
LLM_MAX_TOKENS_EMPATHETIC=80    # For empathetic statements
LLM_MAX_TOKENS_CHRONICITY=60    # For chronicity questions
LLM_MAX_TOKENS_SUMMARY=220      # For summaries

# ============================================
# LLM PARAMETER EXPLANATIONS
# ============================================
# Temperature (0.6): randomness. Lower (0.3–0.5) = tighter, more consistent phrasing. Higher = more variety but more risk of rambling.
# Top P (0.9): nucleus sampling mass. Lower (0.7–0.85) trims tail tokens, reduces tangents; higher adds diversity.
# Top K (40): choose from top-K tokens. Lower (20–40) tightens word choice; very high can introduce drift.
# Repeat Penalty (1.15): discourages repeating recent text. Higher (1.2) curbs loops; too high can distort output.
# Presence Penalty (0.2): encourages introducing new tokens/topics. Lower (0.0–0.2) keeps the model on-topic; higher can nudge it to add extra ideas (less coherent).
# Frequency Penalty (0.2): penalizes frequent token reuse. Slightly higher (0.3) reduces redundancy; too high harms fluency.
# Num Predict (60): max tokens generated. Lower (40–60) reduces multi-question run-on sentences; too low may truncate.
# Stop (\n\n): cut off at boundaries. Use LLM_STOP=\n\n (entered as \\n\\n in .env) to end after one paragraph/sentence block.

# ============================================
# TTS CONFIGURATION
# ============================================
TTS_VOLUME=70
TTS_TOKEN_LIMIT=200

# ============================================
# MEDICAL MODE CONFIGURATION
# ============================================
USE_MEDICAL_MODE=true
USE_MEDICAL_NAVIGATOR=true
USE_MEDICAL_NAVIGATOR=true
ENABLED_MEDICAL_CATEGORIES=GI,CARDIO,DERM,GU,MSK,NEURO,PULMONARY,RENAL

# ============================================
# RAG CONFIGURATION
# ============================================
RAG_MODE=CPU
RAG_THRESHOLD=0.3
RAG_TOP_K=5
RAG_USE_PHONETIC_MATCHING=true

# ============================================
# DEBUG SETTINGS
# ============================================
DEBUG_MODE=false
LOG_LEVEL=INFO
