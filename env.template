# Aura Voice Assistant - Environment Configuration
# This file contains all environment variables for all microservices
# Copy this file to .env and update the values

# =============================================================================
# ELEVENLABS TTS CONFIGURATION
# =============================================================================
# Get your API key from: https://elevenlabs.io/
ELEVEN_API_KEY=your_elevenlabs_api_key_here
ELEVEN_VOICE_ID=your_elevenlabs_voice_id_here

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Model path within the container (models are copied during build)
MODEL_PATH=/models/qwen2.5-1.5b-instruct-q4_0.gguf
CHAT_FORMAT=qwen
N_CTX=1024

# =============================================================================
# GPU CONFIGURATION
# =============================================================================
# CUDA device to use (0 for first GPU, -1 to disable GPU)
CUDA_VISIBLE_DEVICES=0

# =============================================================================
# PYTHON CONFIGURATION
# =============================================================================
# Ensure real-time logging output
PYTHONUNBUFFERED=1

# =============================================================================
# DISPLAY CONFIGURATION (for GUI)
# =============================================================================
# X11 display for GUI applications
DISPLAY=:0

# =============================================================================
# AUDIO CONFIGURATION
# =============================================================================
# PulseAudio runtime path
PULSE_RUNTIME_PATH=/tmp/pulse

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
# Whisper model configuration
WHISPER_MODEL=base.en

# TTS model configuration
PIPER_MODEL_PATH=/models/en_US/en_US-amy-low.onnx
PIPER_CONFIG_PATH=/models/en_US/en_US-amy-low.onnx.json

# RAPIDS/Vector search configuration
VECTOR_INDEX_PATH=/shared/vector_index/index.pkl
DOC_CHUNKS_PATH=/shared/vector_index/doc_chunks.npy
CHUNK_SCORE_THRESHOLD=0.4
MAX_CONTEXT_CHUNKS=3

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level for services
LOG_LEVEL=INFO

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Set to 'true' for development mode
DEBUG=false
